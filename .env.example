VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
# Optional override. If omitted, the app uses:
# <VITE_SUPABASE_URL>/functions/v1/audit-log
VITE_AUDIT_API_URL=

# Vinos module — separate Supabase project
VITE_SUPABASE_URL_VINOS=https://your-vinos-project.supabase.co
VITE_SUPABASE_ANON_KEY_VINOS=your_vinos_anon_key

# Asistente IA — servidor Ollama (modelo local llama3.1)
# VITE_AI_PROVIDER=ollama usa Ollama local; VITE_AI_PROVIDER=openai usa Supabase Edge Function ai-chat.
VITE_AI_PROVIDER=ollama
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.1
# Ventana de contexto. El default de Ollama (4096) trunca el prompt → respuestas vacías.
VITE_OLLAMA_NUM_CTX=16384

# Asistente IA con OpenAI (NO poner estos secretos como VITE_*).
# Configurar en Supabase:
# supabase secrets set OPENAI_API_KEY=sk-...
# supabase secrets set OPENAI_MODEL=gpt-5-mini
